<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately a single override.

  The Android Application Gradle plugin merges the `:app` module's resources over `:common`'s, so a key
  declared here replaces the same key from upstream. That mechanism is what lets this file relabel the
  product. It must stay limited to product identity: putting translated copy in `values/` (the default,
  English, bucket) instead of `values-zh-rCN/` would force that text onto every locale, which is exactly
  what an earlier revision of this fork did with 307 keys.

  Renaming matters here: this APK is signed by a third party and is not the official client, so it must
  not present itself as "Home Assistant" on a device that may also have the official app installed.
-->
<resources>
    <string name="app_name" translatable="false">Home Assistant 无GMS</string>
</resources>
